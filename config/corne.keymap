#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>
/ {
    behaviors {
       
      // Left hand home row mods
        hm_l_ctrl: hm_l_ctrl {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <70>;
            require-prior-idle-ms = <100>;
            bindings = <&kp>, <&kp>;
            // Position 13 (left ctrl) triggers with: other left mods + entire right hand
            hold-trigger-key-positions = <14 15 16 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;
            hold-trigger-on-release;
        };
        
        hm_l_opt: hm_l_opt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <70>;
            require-prior-idle-ms = <100>;
            bindings = <&kp>, <&kp>;
            // Position 14 (left option) triggers with: other left mods + entire right hand
            hold-trigger-key-positions = <13 15 16 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;
            hold-trigger-on-release;
        };
        
        hm_l_cmd: hm_l_cmd {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <70>;
            require-prior-idle-ms = <100>;
            bindings = <&kp>, <&kp>;
            // Position 16 (left command) triggers with: other left mods + entire right hand
            hold-trigger-key-positions = <13 14 15 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;
            hold-trigger-on-release;
        };
        
        // Right hand home row mods (mirrored)
        hm_r_cmd: hm_r_cmd {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <70>;
            require-prior-idle-ms = <100>;
            bindings = <&kp>, <&kp>;
            // Position 19 (right command) triggers with: other right mods + entire left hand
            hold-trigger-key-positions = <20 21 22 0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
            hold-trigger-on-release;
        };
        
        hm_r_opt: hm_r_opt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <70>;
            require-prior-idle-ms = <100>;
            bindings = <&kp>, <&kp>;
            // Position 21 (right option) triggers with: other right mods + entire left hand
            hold-trigger-key-positions = <19 20 22 0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
            hold-trigger-on-release;
        };
        
        hm_r_ctrl: hm_r_ctrl {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <70>;
            require-prior-idle-ms = <100>;
            bindings = <&kp>, <&kp>;
            // Position 22 (right ctrl) triggers with: other right mods + entire left hand
            hold-trigger-key-positions = <19 20 21 0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
            hold-trigger-on-release;
        };
    };

    combos {
        compatible = "zmk,combos";

        left_bkt {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <27 28>;
            timeout-ms = <50>;
        };

        right_bkt {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <31 32>;
            timeout-ms = <50>;
        };

        left_par {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <15 16>;
            timeout-ms = <50>;
        };

        right_par {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <19 20>;
            timeout-ms = <50>;
        };

        left_brace {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <3 4>;
            timeout-ms = <50>;
        };

        right_brace {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <7 8>;
            timeout-ms = <50>;
        };

        less_than {
            bindings = <&kp LESS_THAN>;
            key-positions = <25 26>;
            timeout-ms = <50>;
        };

        greater_than {
            bindings = <&kp GREATER_THAN>;
            key-positions = <33 34>;
            timeout-ms = <50>;
        };

        underscore {
            bindings = <&kp UNDERSCORE>;
            key-positions = <21 22>;
            timeout-ms = <50>;
        };

        colon {
            bindings = <&kp COLON>;
            key-positions = <13 14>;
            timeout-ms = <50>;
        };

        single_quote {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <1 2>;
            timeout-ms = <50>;
        };

        minus {
            bindings = <&kp MINUS>;
            key-positions = <9 10>;
            timeout-ms = <50>;
        };

    };

keymap {
    compatible = "zmk,keymap";

    default_layer {
        display-name = "Base";
        bindings = <
          &kp ASTERISK           &kp Q                  &kp W                  &kp E                  &kp R                  &kp T                  &kp Y                  &kp U                  &kp I                  &kp O                  &kp P                  &kp PLUS
          &kp EQUAL              &kp A                  &hm_l_ctrl LCTRL S     &hm_l_opt LALT D       &hm_l_cmd LGUI F       &kp G                  &kp H                  &hm_r_cmd RGUI J       &hm_r_opt RALT K       &hm_r_ctrl RCTRL L     &kp SEMI               &kp AMPERSAND
          &none                  &kp Z                  &kp X                  &kp C                  &kp V                  &kp B                  &kp N                  &kp M                  &kp COMMA              &kp DOT                &kp SLASH              &none
                                                                               &kp LSHIFT             &kp BSPC               &kp ENTER              &mo 1                  &kp SPACE              &lt 2 CAPS
        >;
    };

    special_layer {
        display-name = "Spcl";
        bindings = <
          &none                  &none                  &kp N7                 &kp N8                 &kp N9                 &none                  &none                  &kp CARET              &kp DOLLAR             &kp PERCENT            &kp GRAVE              &none
          &none                  &none                  &kp N4                 &kp N5                 &kp N6                 &none                  &none                  &kp PIPE               &kp TILDE              &kp HASH               &none                  &none
          &none                  &none                  &kp N1                 &kp N2                 &kp N3                 &none                  &none                  &kp QMARK              &kp EXCL               &kp AMPS               &none                  &none
                                                                               &none                  &kp N0                 &none                  &none                  &none                  &none
        >;
    };

    fn_layer {
        display-name = "Func";
        bindings = <
          &none                  &none                  &kp F7                 &kp F8                 &kp F9                 &none                  &none                  &kp K_MUT              &kp C_VOL_DN           &kp C_VOL_UP           &none                  &none
          &none                  &none                  &kp F4                 &kp F5                 &kp F6                 &none                  &none                  &none                  &kp C_BRI_DN           &kp C_BRI_UP           &none                  &none
          &none                  &none                  &kp F1                 &kp F2                 &kp F3                 &none                  &none                  &none                  &none                  &none                  &none                  &none
                                                                               &none                  &none                  &none                  &none                  &none                  &none
        >;
    };

    extra1 {
        status = "reserved";
    };
    extra2 {
        status = "reserved";
    };
    extra3 {
        status = "reserved";
    };
    extra4 {
        status = "reserved";
    };
};
};
